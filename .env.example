# Runtime mode and server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# strict (default): every log message and string field is fully redacted -
# safe everywhere, but hard to read. partial: messages are readable, but
# fields shaped like tokens/secrets/passwords still redact. none: no
# redaction at all. Only ever set partial/none on your own machine.
LOG_REDACTION_MODE=strict
# Loopback is safe for same-host access or `tailscale serve`. Set this to the
# Mac mini's Tailscale IP when iOS connects directly to port 4000.
API_HOST=127.0.0.1

# Database (provide credentials locally; never commit them)
# DATABASE_URL is the sandbox database used by default. DATABASE_URL_PRODUCTION
# is only read when PLAID_ACTIVE_ENV=production (see start:api:prod below).
DATABASE_URL=
DATABASE_URL_PRODUCTION=
DATABASE_SCHEMA=
DATABASE_ENVIRONMENT=sandbox
TEST_DATABASE_URL=
ALLOW_SHARED_SANDBOX_TEST_DATABASE=false
TEST_SCHEMA_PREFIX=centsible_test_
ALLOW_PUBLIC_DATABASE_MIGRATION=false

# Clerk authentication (provide credentials locally)
# Same sandbox/production split as Plaid above, switched by PLAID_ACTIVE_ENV.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
CLERK_PRODUCTION_SECRET_KEY=
CLERK_PRODUCTION_PUBLISHABLE_KEY=
CLERK_PRODUCTION_JWT_KEY=

# Plaid (provide credentials locally)
# PLAID_ACTIVE_ENV selects sandbox (default) or production. Sandbox uses
# PLAID_CLIENT_ID/PLAID_SECRET/DATABASE_URL/WEBHOOK_BASE_URL below; production
# uses the PLAID_PRODUCTION_*/DATABASE_URL_PRODUCTION/WEBHOOK_BASE_URL_PRODUCTION
# counterparts instead. Set it via `pnpm start:api:prod` / `start:worker:prod`,
# not in this file, so the default always stays sandbox.
PLAID_ACTIVE_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTION_CLIENT_ID=
PLAID_PRODUCTION_SECRET=
PLAID_TOKEN_KEY=
PLAID_REDIRECT_URI=

# Webhook target Plaid calls when an Item has an update (see WEBHOOK_BASE_URL
# split above: sandbox default vs production override).
WEBHOOK_BASE_URL=
WEBHOOK_BASE_URL_PRODUCTION=

# API and cache defaults
API_DOCS_ENABLED=true
CACHE_ENABLED=false
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=1000
CACHE_MAX_BYTES=67108864
CACHE_MAX_ENTRY_BYTES=2097152

# Worker identity (generated when omitted)
WORKER_ID=
WORKER_SWEEP_INTERVAL_MINUTES=360
WORKER_WAKE_URL=http://127.0.0.1:4011/wake
